#!/usr/bin/env bash
# Runs CI's typecheck and fixed-seed test rerun before a push, so a red `check` shows here instead
# of a CI round later. Enabled per clone with `git config core.hooksPath .githooks`.
# Skipped when the branch changes only Markdown, docs/ and .claude/, which neither check reads.
set -euo pipefail

base=origin/main
if ! git diff --name-only "$base...HEAD" | grep -qvE '(\.md$|^docs/|^\.claude/)'; then
  exit 0
fi

npm run typecheck
scripts/test-seeds.sh "$base"
