#!/usr/bin/env bash
# Runs the typecheck `npm run build` starts with and the fixed-seed test rerun, the parts of CI's
# `check` a local `npm test` leaves out, so a red `check` shows here instead of a CI round later.
# Enabled per clone with `git config core.hooksPath .githooks`. It checks the checked-out branch,
# whatever is pushed, and skips a branch whose changes since origin/main are all Markdown.
set -euo pipefail

base=origin/main
changed=$(git diff --name-only "$base...HEAD")
if [ -z "$(grep -v '\.md$' <<<"$changed")" ]; then
  exit 0
fi

npm run typecheck
scripts/test-seeds.sh "$base"
